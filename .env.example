# Copie para .env (na raiz do projeto) e ajuste os valores.
# O mesmo arquivo é lido pelo backend e pelo frontend.

# ---------- Backend ----------
APP_NAME=UNIVAN-API
# Arquivo do banco SQLite, relativo à raiz do projeto.
# Criado por scripts/1-banco.sh (ou pela API, se ainda não existir).
DATABASE_URL=sqlite:///backend/univan.db
# true para exibir no console o SQL gerado pelo SQLAlchemy
DATABASE_ECHO=false
# Origens liberadas no CORS, separadas por vírgula
CORS_ORIGINS=

# ---------- Frontend ----------
# Só variáveis com prefixo VITE_ chegam ao navegador.
# /api passa pelo proxy do Vite; use uma URL completa só se a API estiver em outro host.
VITE_API_URL=/api
# Para onde o Vite (npm run dev) repassa as chamadas a /api
API_PROXY_TARGET=
